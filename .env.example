# Copiar a ".env" y completar.

# Contraseña del administrador (sube, edita y elimina documentos). Si queda vacía, la app es de SOLO LECTURA.
ADMIN_PASSWORD=cambiar-por-una-contrasena-larga

# Clave para firmar las sesiones. Generar una con:  python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Puerto publicado en el servidor (dentro del contenedor siempre es 8000)
HOST_PORT=8000

# Opcionales
MAX_UPLOAD_MB=60
TOKEN_TTL_SECONDS=28800
